# Copy this file to .env locally and replace the placeholder with a real key.
# Never commit .env or a real API key.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.4-mini
# Optional alternative to putting the secret in .env:
# OPENAI_API_KEY_FILE=C:\\path\\to\\openai.txt.txt

# Optional Claude provider. Claude is preferred when both keys exist.
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY_FILE=C:\\path\\to\\claude.txt.txt
# PLANNER_PROVIDER=anthropic
